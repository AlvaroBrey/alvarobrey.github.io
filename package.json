{
  "name": "alvarobrey.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "svelte-kit sync && husky",
    "predev": "pnpm generate-cv-pdf",
    "dev": "vite dev",
    "prebuild": "pnpm generate-cv-pdf",
    "build": "vite build",
    "preview": "vite preview",
    "generate-cv-pdf": "tsx scripts/generate-cv-pdf.ts",
    "precheck": "pnpm run --parallel \"/^(paraglide|generate-cv-pdf)$/\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "paraglide": "node scripts/compile-paraglide.js"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --check",
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.24.1",
    "@mdi/js": "^7.4.47",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "date-fns": "^4.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.8.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
