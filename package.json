{
  "name": "alvarobrey.com",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "generate-cv-pdf": "tsx scripts/generate-cv-pdf.ts",
    "predev": "yarn generate-cv-pdf",
    "dev": "nuxt-ts",
    "build": "nuxt-ts build",
    "start": "nuxt-ts start",
    "pregenerate": "yarn generate-cv-pdf",
    "generate": "rimraf .nuxt dist && nuxt-ts generate",
    "lint:js": "eslint --ext .js,.ts,.vue --ignore-path .gitignore .",
    "lint": "yarn lint:js",
    "serve": "http-server ./dist",
    "generate-serve": "yarn generate && yarn serve"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint"
  },
  "dependencies": {
    "@nuxt/typescript-runtime": "^2.1.0",
    "@nuxtjs/sitemap": "^2.4.0",
    "core-js": "^3.6.5",
    "nuxt": "^2.15.8",
    "nuxt-i18n": "^6.16.0"
  },
  "devDependencies": {
    "@mdi/js": "^5.9.55",
    "@nuxt/types": "^2.15.8",
    "@nuxt/typescript-build": "^2.1.0",
    "@nuxtjs/eslint-config": "^3.1.0",
    "@nuxtjs/eslint-config-typescript": "^3.0.0",
    "@nuxtjs/vuetify": "^1.12.3",
    "babel-eslint": "^10.1.0",
    "date-fns": "^2.16.1",
    "eslint": "^7.10.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-plugin-nuxt": "^1.0.0",
    "eslint-plugin-prettier": "^3.1.4",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^2.1.2",
    "puppeteer": "^25.8.0",
    "rimraf": "^6.1.3",
    "sass": "^1.32.13",
    "sass-loader": "^10.1.1",
    "tsx": "^4.23.12"
  }
}
